# Database
DATABASE_URL=postgresql://aep:aep_dev_password@localhost:5432/ai-engineering-platform

# Set to a long random string in production
AUTH_SECRET=change-me-in-production-use-a-long-random-value

# Session cookie Secure flag. Leave unset to follow APP_URL (https → true).
# Set false for local/Docker HTTP even when NODE_ENV=production.
# COOKIE_SECURE=false

# App
PORT=43127
APP_URL=http://127.0.0.1:43127
NODE_ENV=development
