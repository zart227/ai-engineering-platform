# Database. Compose uses pgvector/pgvector:pg16 so CREATE EXTENSION vector works.
# Set POSTGRES_PASSWORD before `docker compose up` (Compose refuses to start without it).
POSTGRES_PASSWORD=change-me-local-postgres-password
DATABASE_URL=postgresql://aep:change-me-local-postgres-password@localhost:5432/ai-engineering-platform

# Set to a long random string in production
AUTH_SECRET=change-me-in-production-use-a-long-random-value

# Session cookie Secure flag. Leave unset to follow APP_URL (https → true).
# Set false for local/Docker HTTP even when NODE_ENV=production.
# COOKIE_SECURE=false

# App
PORT=43127
APP_URL=http://127.0.0.1:43127
NODE_ENV=development

# Routine tutor (cloud Ollama). Empty key: the tutor fails closed.
OLLAMA_BASE_URL=[REDACTED]
OLLAMA_API_KEY=
OLLAMA_MODEL=minimax-m2.5
OLLAMA_TIMEOUT_SECONDS=120
# Cap completion tokens (Ollama options.num_predict). Default 512.
# OLLAMA_MAX_OUTPUT_TOKENS=512

# Heavy tasks (OpenAI). Not used by the lesson tutor. Empty key: those calls fail closed.
OPENAI_API_KEY=
OPENAI_MODEL=[REDACTED]
OPENAI_TIMEOUT_SECONDS=30
# Cap completion tokens (Responses max_output_tokens). Default 1024.
# OPENAI_MAX_OUTPUT_TOKENS=1024
